  "compilerOptions": {
    "module": "commonjs",
    "target": "es2022",
    "outDir": "out",
    "rootDir": "src",
    "lib": ["es2022"],
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node","vscode"]
  },
  "exclude": ["node_modules",".vscode-test"]
}